<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hse_corrective_action_view_search" model="ir.ui.view">
        <field name="name">hse.corrective.action.search</field>
        <field name="model">hse.corrective.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="finding_id"/>
                <field name="responsible_id"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <filter name="mine" string="Assigned to Me" domain="[('responsible_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hse_corrective_action_view_tree" model="ir.ui.view">
        <field name="name">hse.corrective.action.tree</field>
        <field name="model">hse.corrective.action</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_overdue">
                <field name="reference"/>
                <field name="name"/>
                <field name="finding_id"/>
                <field name="responsible_id"/>
                <field name="date_due"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="is_overdue" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="hse_corrective_action_view_kanban" model="ir.ui.view">
        <field name="name">hse.corrective.action.kanban</field>
        <field name="model">hse.corrective.action</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="reference"/>
                <field name="name"/>
                <field name="responsible_id"/>
                <field name="date_due"/>
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong><field name="reference"/> — <field name="name"/></strong>
                                <div>Responsible: <field name="responsible_id"/></div>
                                <div>Due: <field name="date_due"/></div>
                                <div>Priority: <field name="priority"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hse_corrective_action_view_form" model="ir.ui.view">
        <field name="name">hse.corrective.action.form</field>
        <field name="model">hse.corrective.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object" states="open" class="btn-primary"/>
                    <button name="action_resolve" string="Mark Resolved" type="object" states="open,in_progress" class="btn-primary"/>
                    <button name="action_verify" string="Verify" type="object" states="resolved" class="btn-primary"/>
                    <button name="action_close" string="Close" type="object" states="verified" class="btn-primary"/>
                    <button name="action_reopen" string="Reopen" type="object" states="resolved,verified,closed" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,resolved,verified,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="finding_id"/>
                            <field name="inspection_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="date_due"/>
                            <field name="priority"/>
                            <field name="severity" readonly="1"/>
                            <field name="date_resolved" readonly="1"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="resolution_notes" placeholder="Describe remediation implemented + evidence..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hse_corrective_action_action" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">hse.corrective.action</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
</odoo>
