<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hse_finding_view_search" model="ir.ui.view">
        <field name="name">hse.finding.search</field>
        <field name="model">hse.finding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="inspection_id"/>
                <field name="severity"/>
                <field name="state"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <filter name="mine" string="My Findings" domain="[('responsible_id','=',uid)]"/>
                <filter name="critical" string="Critical" domain="[('severity','=','critical')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_inspection" string="Inspection" context="{'group_by': 'inspection_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hse_finding_view_tree" model="ir.ui.view">
        <field name="name">hse.finding.tree</field>
        <field name="model">hse.finding</field>
        <field name="arch" type="xml">
            <tree decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'">
                <field name="reference"/>
                <field name="name"/>
                <field name="inspection_id"/>
                <field name="severity"/>
                <field name="responsible_id"/>
                <field name="date_found"/>
                <field name="action_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="hse_finding_view_form" model="ir.ui.view">
        <field name="name">hse.finding.form</field>
        <field name="model">hse.finding</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_progress" string="Start Triage" type="object" states="open" class="btn-primary"/>
                    <button name="action_resolve" string="Resolve" type="object" states="open,in_progress" class="btn-primary"/>
                    <button name="action_verify" string="Verify" type="object" states="resolved" class="btn-primary"/>
                    <button name="action_close" string="Close" type="object" states="verified" class="btn-primary"/>
                    <button name="action_reopen" string="Reopen" type="object" states="resolved,verified,closed" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,resolved,verified,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_actions" class="oe_stat_button" icon="fa-tasks">
                            <field name="action_count" widget="statinfo" string="Actions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="inspection_id"/>
                            <field name="question_id" readonly="1"/>
                            <field name="rule_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="severity"/>
                            <field name="responsible_id"/>
                            <field name="date_found"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <notebook>
                        <page string="Corrective Actions">
                            <field name="action_ids" context="{'default_finding_id': id}">
                                <tree>
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="responsible_id"/>
                                    <field name="date_due"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hse_finding_action" model="ir.actions.act_window">
        <field name="name">Findings</field>
        <field name="res_model">hse.finding</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="hse_finding_pivot_action" model="ir.actions.act_window">
        <field name="name">Findings Analysis</field>
        <field name="res_model">hse.finding</field>
        <field name="view_mode">pivot,graph,tree,form</field>
    </record>
</odoo>
