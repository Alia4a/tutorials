<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hse_inspection_view_search" model="ir.ui.view">
        <field name="name">hse.inspection.search</field>
        <field name="model">hse.inspection</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="checklist_id"/>
                <field name="inspector_id"/>
                <field name="equipment_id"/>
                <field name="department_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <filter name="low_compliance" string="Low Compliance (&lt; 80%)" domain="[('compliance_rate','&lt;',80),('state','=','completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_checklist" string="Checklist" context="{'group_by': 'checklist_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_date" string="Date" context="{'group_by': 'date_inspection:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hse_inspection_view_tree" model="ir.ui.view">
        <field name="name">hse.inspection.tree</field>
        <field name="model">hse.inspection</field>
        <field name="arch" type="xml">
            <tree decoration-danger="compliance_rate &lt; 50 and state == 'completed'" decoration-warning="compliance_rate &lt; 80 and state == 'completed'">
                <field name="reference"/>
                <field name="checklist_id"/>
                <field name="date_inspection"/>
                <field name="inspector_id"/>
                <field name="equipment_id"/>
                <field name="compliance_rate"/>
                <field name="finding_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="hse_inspection_line_view_tree_editable" model="ir.ui.view">
        <field name="name">hse.inspection.line.tree.editable</field>
        <field name="model">hse.inspection.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" invisible="1"/>
                <field name="question_id" readonly="1"/>
                <field name="question_type" invisible="1"/>
                <field name="is_required" invisible="1"/>
                <field name="pass_fail" attrs="{'invisible': [('question_type','!=','pass_fail')], 'required': [('is_required','=',True)]}"/>
                <field name="yes_no" attrs="{'invisible': [('question_type','!=','yes_no')]}"/>
                <field name="number_value" attrs="{'invisible': [('question_type','!=','numeric')]}"/>
                <field name="number_set" invisible="1"/>
                <field name="text_value" attrs="{'invisible': [('question_type','!=','text')]}"/>
                <field name="selection_value" attrs="{'invisible': [('question_type','!=','selection')]}"/>
                <field name="date_value" attrs="{'invisible': [('question_type','!=','date')]}"/>
                <field name="attachment_filename" invisible="1"/>
                <field name="attachment" widget="binary" filename="attachment_filename" attrs="{'invisible': [('question_type','not in',('file',))]}"/>
                <field name="notes"/>
                <field name="is_answered" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="hse_inspection_view_form" model="ir.ui.view">
        <field name="name">hse.inspection.form</field>
        <field name="model">hse.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start Inspection" type="object" states="draft" class="btn-primary"/>
                    <button name="action_complete" string="Complete &amp; Submit" type="object" states="draft,in_progress" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,in_progress" class="btn-secondary"/>
                    <button name="action_draft" string="Reset to Draft" type="object" states="canceled" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed,canceled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_findings" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="finding_count" widget="statinfo" string="Findings"/>
                        </button>
                        <button type="object" name="action_view_actions" class="oe_stat_button" icon="fa-tasks">
                            <field name="action_count" widget="statinfo" string="Actions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="checklist_id" attrs="{'readonly': [('state','not in',('draft',))]}"/>
                            <field name="inspector_id"/>
                            <field name="date_inspection"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="equipment_id"/>
                            <field name="compliance_rate" readonly="1"/>
                            <field name="overdue_action_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="General observations..."/>
                    <notebook>
                        <page string="Answers">
                            <field name="line_ids" context="{'default_inspection_id': id}" attrs="{'readonly': [('state','not in',('draft','in_progress'))]}"/>
                        </page>
                        <page string="Findings">
                            <field name="finding_ids" readonly="1">
                                <tree>
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="state"/>
                                    <field name="responsible_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Corrective Actions">
                            <field name="action_ids" readonly="1">
                                <tree decoration-danger="is_overdue">
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="responsible_id"/>
                                    <field name="date_due"/>
                                    <field name="priority"/>
                                    <field name="state"/>
                                    <field name="is_overdue" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hse_inspection_action" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">hse.inspection</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
