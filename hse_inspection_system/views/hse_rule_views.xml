<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hse_rule_view_search" model="ir.ui.view">
        <field name="name">hse.rule.search</field>
        <field name="model">hse.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="checklist_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="by_checklist" string="Checklist" context="{'group_by': 'checklist_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hse_rule_view_tree" model="ir.ui.view">
        <field name="name">hse.rule.tree</field>
        <field name="model">hse.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="checklist_id"/>
                <field name="apply_on"/>
                <field name="active"/>
                <field name="triggered_count"/>
            </tree>
        </field>
    </record>

    <record id="hse_rule_view_form" model="ir.ui.view">
        <field name="name">hse.rule.form</field>
        <field name="model">hse.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Emergency Stop failed → Critical Finding"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="checklist_id"/>
                            <field name="apply_on"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="triggered_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="IF ... THEN ..."/>
                    <notebook>
                        <page string="Conditions (IF)">
                            <p class="oe_grey">Each condition tests one question's answer. Example: Question “Emergency Stop” Equals “fail”. Operators are filtered by question type: Pass/Fail and Yes/No only allow Equals / Not Equals / Empty checks.</p>
                            <field name="condition_ids" context="{'default_rule_id': id}">
                                <tree editable="bottom">
                                    <field name="question_id"/>
                                    <field name="question_type" invisible="1"/>
                                    <field name="operator" widget="hse_condition_operator"/>
                                    <field name="value_target" attrs="{'invisible': [('operator', 'in', ('is_empty', 'is_not_empty'))], 'required': [('operator', 'in', ('equals', 'not_equals', 'contains', 'not_contains', 'greater_than', 'less_than', 'greater_equal', 'less_equal'))]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Actions (THEN)">
                            <field name="action_ids" context="{'default_rule_id': id}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="action_type"/>
                                    <field name="severity"/>
                                    <field name="priority"/>
                                    <field name="responsible_id"/>
                                    <field name="due_days"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="action_type"/>
                                            <field name="severity" attrs="{'invisible': [('action_type','=','notify')]}"/>
                                            <field name="priority" attrs="{'invisible': [('action_type','=','notify')]}"/>
                                        </group>
                                        <group>
                                            <field name="responsible_id"/>
                                            <field name="due_days" attrs="{'invisible': [('action_type','=','notify')]}"/>
                                            <field name="sequence"/>
                                        </group>
                                    </group>
                                    <field name="message"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hse_rule_action" model="ir.actions.act_window">
        <field name="name">Business Rules</field>
        <field name="res_model">hse.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
